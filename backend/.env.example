# Server
PORT=3001
# production recommended: NODE_ENV=production
# Comma-separated allowed browser origins for CORS (omit for local dev — allows all)
# CORS_ORIGIN=https://your-spa.example.com

# Database
DB_HOST=<your-db-host>
DB_USER=<your-db-user>
DB_PASSWORD=<your-db-password>
DB_DATABASE=petsitting
# Many managed MySQL services (e.g. AWS RDS) require TLS — set DB_SSL=1 if connections fail or host requires SSL
# DB_SSL=1
# Only if the provider uses a self-signed cert (avoid in production if possible):
# DB_SSL_REJECT_UNAUTHORIZED=0

# Behind nginx / AWS ALB / Zone reverse proxy, set so Express sees correct client IP and secure cookies (if you add them later)
# TRUST_PROXY=1

# Optional (recommended) separate DB for integration tests
DB_TEST_DATABASE=petsitting_test

# Demo users (seed scripts only). Pick any value locally; do not commit real passwords.
# Required for: node seeders/seed-demo-users.js or npm run seed
DEMO_SEED_PASSWORD=

# JWT
JWT_SECRET=<your-jwt-secret>
